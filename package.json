{
  "name": "@opusclient/discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Official Opus Client Discord community management and moderation bot",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "node --watch --env-file=.env src/index.js",
    "deploy": "node --env-file=.env src/deploy-commands.js",
    "ids": "node --env-file=.env scripts/list-ids.js",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
