{
  "name": "@opusclient/discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Official Opus Client Discord community management and moderation bot",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && node scripts/sync-web-assets.mjs",
    "start": "node --env-file=.env dist/index.js",
    "dev": "node --watch --env-file=.env dist/index.js",
    "deploy": "node --env-file=.env dist/deploy-commands.js",
    "ids": "node --env-file=.env scripts/list-ids.js",
    "typecheck": "tsc -p tsconfig.strict.json --noEmit && tsc -p tsconfig.web.strict.json --noEmit",
    "test": "npm run build && node scripts/test-typescript-dist.mjs",
    "guard:cutover": "node scripts/check-typescript-guards.mjs",
    "verify": "npm run build && npm run typecheck && npm run check:build && npm run guard:cutover && npm run test:compiled",
    "check:build": "node scripts/check-typescript-build.mjs",
    "test:compiled": "node scripts/test-typescript-dist.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
